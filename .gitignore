# This project had no .gitignore at all prior to this file being
# added — if that's surprising, it's likely the same cause as
# .github/workflows/ being absent despite the README documenting it
# in detail: some export/zip step along the way appears to have
# dropped dotfiles. Worth confirming against the actual git history
# rather than assuming this is the first .gitignore this project has
# ever had.

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart

# Android
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/gradle/wrapper/gradle-wrapper.jar
android/local.properties
android/key.properties
*.keystore
*.jks

# Never commit an actual release keystore or its passwords, however
# they're named — android/key.properties (see key.properties.example)
# and *.keystore/*.jks are covered above specifically because of this.
# CI gets equivalent values from GitHub Actions secrets instead; see
# the README's Continuous Integration section.

# Firebase / telemetry provider config. Not secret exactly, but
# environment config generated per-project — see
# lib/services/firebase_telemetry.dart.template for how it's used.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# macOS
.DS_Store

# Anthropic/Claude Code sandbox artifacts, if ever generated inside
# this repo directly.
.claude/
