<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget metadata for SkincareWidgetProvider. See
  hydration_widget_info.xml's comment for why updatePeriodMillis is
  just a periodic safety net rather than the real update mechanism.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="90dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/skincare_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/skincare_widget_description"/>
