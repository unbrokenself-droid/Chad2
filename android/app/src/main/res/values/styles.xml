<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Activity while Flutter is initializing.
         Shows a plain white background so there's no flash of an
         unstyled system default before the first frame is drawn. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme applied once Flutter has drawn its first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
