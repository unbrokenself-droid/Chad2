<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded pill background for each widget's single tap target, using
  AppTheme's blue accent (lib/core/theme/app_colors.dart's
  blueAccent, 0xFF2962FF) so the tap target reads as the same "primary
  action" color as PrimaryButton does everywhere else in the app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2962FF"/>
    <corners android:radius="999dp"/>
</shape>
